# ============================================================================
# CRM Environment Variables
# Copy this file to .env and fill in the values
# ============================================================================

NODE_ENV=development

VITE_PUBLIC_SITE_URL=http://localhost:3001
VITE_API_URL=http://localhost:3001

DATABASE_URL="postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/crm?sslmode=require"
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DATABASE="postgresql://aryaminakshi:postgres@localhost:5432/crm_db"

BETTER_AUTH_SECRET="your-better-auth-secret-at-least-32-characters-long"
BETTER_AUTH_URL=http://localhost:3001
BETTER_AUTH_BASE_PATH=/api/auth
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3001

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

STRIPE_SECRET_KEY="sk_test_crm_xxx"
STRIPE_WEBHOOK_SECRET="whsec_crm_xxx"
VITE_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_crm_xxx"

VITE_PUBLIC_POSTHOG_KEY=""
VITE_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

VITE_PUBLIC_CDN_URL=""

# ============================================================================
# CLOUDFLARE
# ============================================================================

CLOUDFLARE_ACCOUNT_ID="xxx"
R2_ACCESS_KEY_ID="xxx"
R2_SECRET_ACCESS_KEY="xxx"
R2_BUCKET_NAME="crm-assets"
R2_ENDPOINT="https://5653e251831c2c70630d01d1c4b39a71.r2.cloudflarestorage.com"

LOG_LEVEL=info
SENTRY_DSN=""

# Demo credentials for frontend (only use in development)
VITE_DEMO_EMAIL=demo@nucleo.one
VITE_DEMO_PASSWORD=password

# ============================================================================
# White-label branding (optional - defaults to Nucleo One)
# ============================================================================
VITE_BRAND_NAME=Nucleo One
VITE_BRAND_TAGLINE=All-in-One Business Management Platform
VITE_PRIMARY_COLOR=
VITE_THEME_COLOR=#e11d48
VITE_LOGO_URL=
VITE_SUPPORT_EMAIL=support@nucleoone.com
VITE_TWITTER_HANDLE=@nucleoone

# ── Transactional email (Resend) ─────────────────────────────────────────────
# Get a key at https://resend.com/api-keys. Without it, emails are logged to
# the console instead of sent (safe for local dev and demos).
RESEND_API_KEY=
EMAIL_FROM="noreply@yourdomain.com"

# ── Read replica (optional) ──────────────────────────────────────────────────
# Point analytics/dashboard reads at a Neon read replica so they don't compete
# with writes. Leave empty to use the primary for everything.
DATABASE_READ_URL=
