{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nucleo-one",
  "main": "./src/server.ts",
  "compatibility_date": "2025-01-10",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "assets": {
    "binding": "ASSETS"
  },
  "vars": {
    "NODE_ENV": "development",
    "VITE_PUBLIC_SITE_URL": "http://localhost:3001",
    "GITHUB_CLIENT_ID": "Ov23lisZl4Qy17lPjxRg",
    "GITHUB_CLIENT_SECRET": "fac9f7a554e9fdd5d515fb487cbe8b5297b1f908",
    "DATABASE_URL": "postgresql://neondb_owner:npg_zeumGs2rg5hj@ep-spring-mode-ahv0l3tt-pooler.c-3.us-east-1.aws.neon.tech/neondb?sslmode=require"
  },
  "routes": [
    {
      "pattern": "nucleo-one.aryaminakshi.workers.dev",
      "zone_name": "aryaminakshi.workers.dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "placeholder-kv-id"
    }
  ],
  "upstash_redis": [
    {
      "binding": "REDIS",
      "rest_api_url": "https://placeholder.upstash.io",
      "rest_api_token": "placeholder-token"
    }
  ],
  "dev": {
    "port": 3017
  }
}
