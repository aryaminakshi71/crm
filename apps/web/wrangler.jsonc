{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "crm-web",
  "main": "./src/server.ts",
  "compatibility_date": "2025-01-10",
  "compatibility_flags": [
    "nodejs_compat",
    "nodejs_compat_populate_process_env"
  ],
  "hyperdrive": [
    {
      "binding": "DATABASE",
      "id": "placeholder-create-hyperdrive-first"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "crm-assets-production"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b30d4289f97e4bb88f04a44a16f4459d"
    }
  ],
  "vars": {
    "NODE_ENV": "development",
    "VITE_PUBLIC_SITE_URL": "http://localhost:3001"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "dev": {
    "port": 3001
  }
}
