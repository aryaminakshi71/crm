{
  "extends": "../../packages/tsconfig/react.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@crm/ui": ["../../packages/ui/src"],
      "@crm/ui/*": ["../../packages/ui/src/*"],
      "@crm/env": ["../../packages/env/src/client.ts"],
      "@crm/env/*": ["../../packages/env/src/*"],
      "@crm/auth": ["../../packages/auth/src"],
      "@crm/auth/*": ["../../packages/auth/src/*"],
      "@crm/core": ["../../packages/core/src"],
      "@crm/core/*": ["../../packages/core/src/*"],
      "@crm/shared": ["../../packages/shared/src"],
      "@crm/shared/*": ["../../packages/shared/src/*"],
      "@crm/storage": ["../../packages/storage/src"],
      "@crm/storage/*": ["../../packages/storage/src/*"],
      "@crm/logger": ["../../packages/logger/src"],
      "@crm/logger/*": ["../../packages/logger/src/*"],
      "@crm/services": ["../../packages/services/src"],
      "@crm/services/*": ["../../packages/services/src/*"],
      "@crm/workflows": ["../../packages/workflows/src"],
      "@crm/workflows/*": ["../../packages/workflows/src/*"],
      "@crm/ads": ["../../packages/ads/src"],
      "@crm/ads/*": ["../../packages/ads/src/*"],
      "@crm/api": ["../../apps/api/src"],
      "@crm/api/*": ["../../apps/api/src/*"],
      "@shared/saas-core": ["../../shared-saas-core"],
      "@shared/saas-core/*": ["../../shared-saas-core/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/test/**"
  ]
}
