{
  "name": "@crm/api",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "dev": "WRANGLER_HYPERDRIVE_LOCAL_CONNECTION_STRING_DATABASE=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/crm_db} wrangler dev src/index.ts",
    "deploy": "wrangler deploy --minify src/index.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./context": "./src/context.ts",
    "./router": "./src/routers/index.ts"
  },
  "dependencies": {
    "@crm/auth": "workspace:*",
    "@crm/env": "workspace:*",
    "@crm/logger": "workspace:*",
    "@crm/storage": "workspace:*",
    "@orpc/openapi": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@orpc/zod": "^1.13.4",
    "@scalar/hono-api-reference": "^0.9.39",
    "@sentry/cloudflare": "^10.36.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.1",
    "better-auth": "^1.4.18",
    "dd-trace": "^5.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.7",
    "openai": "^6.18.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@crm/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^22.19.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.63.0"
  }
}
