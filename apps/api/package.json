    "@orpc/openapi": "^1.13.4",
    "@orpc/server": "^1.13.4",
    "@orpc/zod": "^1.13.4",
    "@scalar/hono-api-reference": "^0.9.39",
    "@sentry/cloudflare": "^10.36.0",
    "@upstash/ratelimit": "^2.0.7",
    "@upstash/redis": "^1.36.1",
    "better-auth": "1.7.7",
    "dd-trace": "^5.0.0",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.11.7",
    "openai": "^6.18.0",
    "stripe": "^20.4.1",
    "zod": "^4.1.13"
  },
