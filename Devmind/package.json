{
  "name": "tanstack-start-template",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:e2e": "E2E_TEST=1 playwright test",
    "test:e2e:ui": "E2E_TEST=1 playwright test --ui",
    "test:all": "bun run test && bun run test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "clean": "rm -rf node_modules .turbo",
    "test:integration": "vitest run src/integration --passWithNoTests",
    "cap:android": "npx capacitor android",
    "cap:ios": "npx capacitor ios",
    "cap:sync": "npx capacitor sync",
    "cap:open:android": "npx capacitor open android",
    "cap:open:ios": "npx capacitor open ios"
  },
