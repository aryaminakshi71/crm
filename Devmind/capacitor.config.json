{
  "appId": "com.devmind.app",
  "appName": "DevMind",
  "webDir": "dist/client",
  "server": {
    "url": "https://b0a12d5c.devmind-e8h.pages.dev",
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": true,
      "backgroundColor": "#0a0a0b",
      "androidScaleType": "CENTER_CROP",
      "iosSpinnerStyle": "large",
      "showSpinner": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0b"
    },
    "Keyboard": {
      "resize": "body",
      "scrollPadding": true
    },
    "App": {
      "launchMode": "singleTask"
    }
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true
  },
  "ios": {
    "cordovaFlavor": "capacitor",
    "cordovaSwiftVersion": "5.0",
    "minVersion": "13.0",
    "allowMixedContent": true,
    "captureInput": true,
    "xcodeVersion": "15.0"
  }
}
