{
  "name": "crm",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:no-cloudflare": "cd apps/web && SKIP_CLOUDFLARE=true bun run dev",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "clean": "rm -rf node_modules .turbo && find . -name 'node_modules' -type d -prune -exec rm -rf {} + && find . -name '.turbo' -type d -prune -exec rm -rf {} +",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:studio": "turbo run db:studio",
    "test:links": "E2E_TEST=1 playwright test e2e/link-testing.spec.ts",
    "test:links:ui": "E2E_TEST=1 playwright test e2e/link-testing.spec.ts --ui",
    "test:links:report": "playwright show-report",
    "apps:init": "bun run scripts/manage-apps.ts init",
    "apps:add": "bun run scripts/manage-apps.ts add",
    "apps:remove": "bun run scripts/manage-apps.ts remove",
    "apps:list": "bun run scripts/manage-apps.ts list",
    "apps:show": "bun run scripts/manage-apps.ts show",
    "apps:generate": "bun run scripts/manage-apps.ts generate",
    "apps:generate-all": "bun run scripts/manage-apps.ts generate-all",
    "apps:validate": "bun run scripts/manage-apps.ts validate",
    "apps:export": "bun run scripts/manage-apps.ts export",
    "apps:stats": "bun run scripts/manage-apps.ts stats",
    "apps:costs": "bun run scripts/manage-apps.ts costs",
    "apps:checklist": "bun run scripts/manage-apps.ts checklist",
    "apps:services": "bun run scripts/manage-apps.ts services",
    "test": "bun run --workspaces --if-present test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@clack/prompts": "^0.11.0",
    "@playwright/test": "^1.57.0",
    "turbo": "^2.4.4"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1"
  }
}
