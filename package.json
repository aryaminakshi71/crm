{
  "name": "nucleoai",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "bun run dev:web & bun run dev:api",
    "dev:no-cloudflare": "cd apps/web && SKIP_CLOUDFLARE=true bun run dev",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck && bun run --cwd apps/mobile typecheck && bun run --cwd packages/env typecheck && bun run --cwd packages/shared typecheck && bun run --cwd packages/storage typecheck && bun run --cwd packages/ui typecheck && bun run --cwd packages/workflows typecheck",
    "guard:lockfiles": "bash scripts/ci/check-lockfiles.sh",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check --write .",
    "clean": "rm -rf node_modules .turbo && find . -name 'node_modules' -type d -prune -exec rm -rf {} + && find . -name '.turbo' -type d -prune -exec rm -rf {} +",
    "db:generate": "bun run --cwd packages/storage db:generate",
    "db:push": "bun run --cwd packages/storage db:push",
    "db:migrate": "bun run --cwd packages/storage db:migrate",
    "db:studio": "bun run --cwd packages/storage db:studio",
    "test": "bun run test:unit",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:ci": "turbo run test:ci",
    "test:unit": "bun run --cwd apps/web test && bun run --cwd apps/mobile test",
    "test:integration": "bun run --cwd apps/api test:integration",
    "test:e2e": "E2E_TEST=1 playwright test",
    "test:smoke": "PLAYWRIGHT_BASE_URL=http://127.0.0.1:3001 playwright test e2e/link-testing.spec.ts --project=chromium",
    "test:e2e:ui": "E2E_TEST=1 playwright test --ui",
    "test:all": "bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:links": "E2E_TEST=1 playwright test e2e/link-testing.spec.ts",
    "test:links:ui": "E2E_TEST=1 playwright test e2e/link-testing.spec.ts --ui",
    "test:links:report": "playwright show-report",
    "security:audit": "bun audit",
    "security:scan": "bunx snyk test",
    "apps:init": "bun run scripts/manage-apps.ts init",
    "apps:add": "bun run scripts/manage-apps.ts add",
    "apps:remove": "bun run scripts/manage-apps.ts remove",
    "apps:list": "bun run scripts/manage-apps.ts list",
    "apps:show": "bun run scripts/manage-apps.ts show",
    "apps:generate": "bun run scripts/manage-apps.ts generate",
    "apps:generate-all": "bun run scripts/manage-apps.ts generate-all",
    "apps:validate": "bun run scripts/manage-apps.ts validate",
    "apps:export": "bun run scripts/manage-apps.ts export",
    "apps:stats": "bun run scripts/manage-apps.ts stats",
    "apps:costs": "bun run scripts/manage-apps.ts costs",
    "apps:checklist": "bun run scripts/manage-apps.ts checklist",
    "apps:services": "bun run scripts/manage-apps.ts services",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:mobile": "bun run --cwd apps/mobile start",
    "mobile:doctor": "bun run --cwd apps/mobile doctor",
    "mobile:reset": "bun run --cwd apps/mobile reset:workspace",
    "mobile:release:android": "bun run --cwd apps/mobile release:android",
    "mobile:release:ios": "bun run --cwd apps/mobile release:ios",
    "mobile:submit:android": "bun run --cwd apps/mobile submit:android",
    "mobile:submit:ios": "bun run --cwd apps/mobile submit:ios",
    "db:optimize": "bash scripts/db-indexes.sh --apply && bash scripts/db-trigram.sh --apply && bash scripts/db-triggers.sh --apply",
    "db:health": "bash scripts/db-health.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@clack/prompts": "^0.11.0",
    "@playwright/test": "^1.57.0",
    "@types/bcryptjs": "^3.0.0",
    "bcryptjs": "^3.0.3",
    "turbo": "^2.4.4",
    "@cloudflare/workers-types": "^4.20250109.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "@platform/email": "workspace:*"
  },
  "overrides": {
    "@tanstack/query-core": "5.90.20"
  }
}
