{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**", ".output/**"]
    },
    "@crm/ui#build": {
      "dependsOn": ["^build"],
      "outputs": [
        "src/**/*.js",
        "src/**/*.js.map",
        "src/**/*.d.ts",
        "src/**/*.d.ts.map"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "cache": false
    },
    "format": {
      "cache": false
    }
  }
}
